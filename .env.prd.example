# ---- Backend profile ----
APP_PROFILE=prd
NODE_ENV=production
PORT=8080
WEB_ORIGIN=https://your-folio-web.example.com

# ---- Backend required in prd ----
DATABASE_URL=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ---- Codex (PR decomposition) ----
# Auth is the host's Codex CLI session (~/.codex); `codex login` on the deploy host.
FOLIO_DECOMP_MODEL=gpt-5.5
FOLIO_DECOMP_LLM=1

# ---- Web profile ----
NEXT_PUBLIC_APP_PROFILE=prd
NEXT_PUBLIC_API_BASE_URL=https://your-folio-api.example.com
