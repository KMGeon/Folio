# ---- Database ----
DATABASE_URL=postgres://folio:folio@localhost:5433/folio

# ---- Codex (PR decomposition) ----
# Codex SDK authenticates via the local Codex CLI session (~/.codex), not an env
# key. Run `codex login` once. Set FOLIO_DECOMP_LLM=0 to force the deterministic
# fallback. OPENAI_API_KEY is optional and overrides the subscription auth.
FOLIO_DECOMP_MODEL=gpt-5.5
FOLIO_DECOMP_LLM=1
OPENAI_API_KEY=

# Ollama fallback (decomposition): tried when Codex fails, before the deterministic fallback.
FOLIO_DECOMP_OLLAMA=1                          # "0" disables the Ollama slot (Codex → deterministic)
FOLIO_DECOMP_OLLAMA_URL=http://localhost:11434/v1
FOLIO_DECOMP_OLLAMA_MODEL=qwen2.5-coder:14b    # a coder model decomposes better
FOLIO_DECOMP_CODEX_COOLDOWN_MS=60000           # circuit breaker open duration after a Codex failure

# ---- GitHub App ----
GITHUB_APP_ID=000000
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_APP_SLUG=folio-app
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ---- Backend (NestJS) ----
APP_PROFILE=dev
NODE_ENV=development
PORT=8080
# Next.js web dev origin allowed for CORS
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8080
FOLIO_WEB_BASE_URL=http://localhost:5173

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
