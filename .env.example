# ---- Database ----
DATABASE_URL=postgres://folio:folio@localhost:5433/folio

# ---- Anthropic (decomposition + Foliant) ----
ANTHROPIC_API_KEY=dummy-anthropic-key
FOLIO_DECOMP_MODEL=claude-sonnet-4-6

# ---- GitHub App ----
GITHUB_APP_ID=000000
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_APP_SLUG=folio-app
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ---- Backend (NestJS) ----
APP_PROFILE=dev
NODE_ENV=development
PORT=8080
# Next.js web dev origin allowed for CORS
WEB_ORIGIN=http://localhost:5173

# ---- Web (Next.js) ----
NEXT_PUBLIC_APP_PROFILE=dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
