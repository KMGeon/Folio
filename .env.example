# ---- Database ----
# Dev and production both use Supabase-hosted Postgres.
# Use the Database connection string, not the Supabase API URL or API keys.
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ---- Codex (PR decomposition) ----
FOLIO_DECOMP_MODEL=gpt-5.5

# ---- GitHub App ----
GITHUB_APP_ID=000000
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_APP_SLUG=folio-app
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional stable numeric GitHub user ID used only to seed the first system admin.
SYSTEM_ADMIN_BOOTSTRAP_GITHUB_ID=

# ---- Backend (NestJS) ----
APP_PROFILE=dev
NODE_ENV=development
PORT=8080
# Next.js web dev origin allowed for CORS
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8080
FOLIO_WEB_BASE_URL=http://localhost:5173

# ---- Web (Next.js) ----
NEXT_PUBLIC_APP_PROFILE=dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
